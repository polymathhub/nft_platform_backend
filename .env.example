# ============================================================
# NFT PLATFORM BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# Sensitive values: marked with [SENSITIVE]
#

# ============================================================
# APPLICATION SETTINGS
# ============================================================
ENVIRONMENT=development          # Options: development, staging, production
DEBUG=false                       # Enable debug mode (false for production)
LOG_LEVEL=INFO                    # Options: DEBUG, INFO, WARNING, ERROR
APP_NAME=NFT Platform Backend
APP_VERSION=1.0.0


# ============================================================
# DATABASE - REQUIRED
# ============================================================
# PostgreSQL connection URL with asyncpg driver
# Format: postgresql+asyncpg://user:password@host:port/database_name
# Example: postgresql+asyncpg://nft_user:SecurePassword123@localhost:5432/nft_platform
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nft_platform  # [SENSITIVE]
DATABASE_ECHO=false              # Log all SQL queries (false for production)


# ============================================================
# CACHE & SESSIONS - REQUIRED
# ============================================================
# Redis connection URL for caching and session management
# Format: redis://user:password@host:port/db
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0  # [SENSITIVE]


# ============================================================
# AUTHENTICATION - REQUIRED
# ============================================================
# JWT secret key for token signing (32+ characters)
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=your-32-char-secret-key-here-generate-with-openssl  # [SENSITIVE]
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24          # Token expiration time
REFRESH_TOKEN_EXPIRATION_DAYS=30 # Refresh token expiration

# Login security settings
LOGIN_MAX_ATTEMPTS=5             # Max failed login attempts
LOGIN_BLOCK_MINUTES=15           # Lockout duration


# ============================================================
# ENCRYPTION - REQUIRED
# ============================================================
# Fernet key for encrypting wallet mnemonics (44 characters)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ NEVER rotate this in production - invalidates all encrypted data
MNEMONIC_ENCRYPTION_KEY=VJQ0Q1eL2e3eL2eL2eL2eL2eL2eL2eL2eL2eL2eL=  # [SENSITIVE]


# ============================================================
# TELEGRAM INTEGRATION
# ============================================================
# Telegram bot token from @BotFather
# Get from: https://t.me/BotFather > /newbot
TELEGRAM_BOT_TOKEN=123456:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh  # [SENSITIVE]

# Telegram webhook configuration
# For local development: leave empty (uses polling instead)
# For production: https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://your-railway-domain.up.railway.app/api/v1/telegram/webhook

# Secret token for webhook validation (optional but recommended)
# Generate: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret  # [SENSITIVE]

# Auto-setup webhook on startup (development: false, production: true)
TELEGRAM_AUTO_SETUP_WEBHOOK=false

# Application Base URL (used for manifest and public endpoints)
# REQUIRED for production: must be full HTTPS URL
# Examples:
#   - Local: http://localhost:8000
#   - Production: https://nftplatformbackend-production-ee5f.up.railway.app
APP_URL=https://your-railway-domain.up.railway.app

# Web App URL shown in Telegram (derived from APP_URL if not set)
# Format: https://domain.com/webapp/
TELEGRAM_WEBAPP_URL=https://your-railway-domain.up.railway.app/webapp/

# Telegram app credentials (for Telegram client integration, optional)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Banner image for /start command
BANNER_IMAGE_URL=https://image2url.com/r2/default/images/1771155009572-149f055b-78f0-4595-bfc2-fdd990329354.png


# ============================================================
# BLOCKCHAIN RPC & CONFIGURATION
# ============================================================
# TON blockchain
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_WORKCHAIN=0

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# Ethereum
ETHEREUM_RPC_URL=https://eth.public.blastapi.io

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Optimism
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Base
BASE_RPC_URL=https://mainnet.base.org

# Avalanche
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Bitcoin
BITCOIN_RPC_URL=https://blockstream.info/api


# ============================================================
# IPFS CONFIGURATION
# ============================================================
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs


# ============================================================
# STABLECOINS (USDT) CONFIGURATION
# ============================================================
USDT_ENABLED=true
USDT_DECIMALS=6
USDT_MIN_TRANSACTION=1.0

# USDT contract addresses
USDT_CONTRACT_ETHEREUM=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_CONTRACT_POLYGON=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
USDT_CONTRACT_ARBITRUM=0xFd086bC7CD5C481DCC9C85Ebe698Ad90E1B4d4Dd
USDT_CONTRACT_OPTIMISM=0x94b008aA00579c1307B0EF2c499aD98a8ce58e58
USDT_CONTRACT_AVALANCHE=0x9702230A8Ea53601f5aD2f56603AE1BeA3eB2d93
USDT_CONTRACT_BASE=0xfde4C96c1286F4B9D7d4A537B9949cFfDA43a26d


# ============================================================
# COMMISSION & PAYMENTS
# ============================================================
COMMISSION_RATE=0.02             # 2% by default
COMMISSION_WALLET_TON=TMUSBPnZrpcgjaQM2eyugmoPTDf6EfibFd
COMMISSION_WALLET_TRC20=0x892b8ba9c9566f22217e74d661d95eff56aa2ba6
COMMISSION_WALLET_ERC20=0x892b8ba9c9566f22217e74d661d95eff56aa2ba6
COMMISSION_WALLET_SOLANA=3PFSpY3MeLXVxzJT7KY8AVSjG99v3dQnDjNwH6msYoAg


# ============================================================
# ADMIN SETTINGS
# ============================================================
ADMIN_PASSWORD=ChangeMe123!      # Default admin password


# ============================================================
# CORS & SECURITY
# ============================================================
# Comma-separated list of allowed origins for CORS
# Examples:
# - Development: http://localhost:3000,http://localhost:8000
# - Production: https://app.example.com,https://web.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Require HTTPS for secure cookies
REQUIRE_HTTPS=false              # Set to true in production

# Maximum request size (10 MB by default)
MAX_REQUEST_SIZE=10485760

# Rate limiting
API_RATE_LIMIT=100               # Requests per window
API_RATE_LIMIT_WINDOW=60         # Window in seconds


# ============================================================
# CORS HEADERS
# ============================================================
# Allowed HTTP headers for CORS requests
CORS_ALLOW_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With,X-Telegram-Web-App-Data,X-Telegram-Init-Data


# ============================================================
# SERVER CONFIGURATION
# ============================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4                        # Number of uvicorn workers


# ============================================================
# DATABASE AUTO-MIGRATION
# ============================================================
AUTO_MIGRATE=true                # Run Alembic migrations on startup


# ============================================================
# PLATFORM WALLETS & KEYS [SENSITIVE]
# ============================================================
# Platform custodial wallets for receiving deposits
# Format: blockchain_name=address
# Example: TON=EQCqE6G7K... Solana=9B5... ETH=0x892b...
PLATFORM_WALLETS=

# Platform private keys for signing payouts [SENSITIVE]
# Format: blockchain_name=private_key
# Example: TON=abc123... Solana=5JVu... ETH=0x123...
PLATFORM_PRIVATE_KEYS=

